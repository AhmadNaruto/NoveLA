<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<application>
		<activity
			android:name="my.noveldokusha.features.reader.ReaderActivity"
			android:configChanges="orientation|screenSize|keyboardHidden" />
		<activity
			android:name="my.noveldokusha.features.reader.manga.MangaReaderActivity"
			android:exported="false"
			android:configChanges="orientation|screenSize|keyboardHidden" />
		<activity
			android:name="my.noveldokusha.features.reader.video.VideoPlayerActivity"
			android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
			android:exported="false"
			android:launchMode="singleTask" />

		<!-- Офлайн-видео (Task 14): тип dataSync — по доке media3. -->
		<service
			android:name="my.noveldokusha.features.reader.video.VideoDownloadService"
			android:exported="false"
			android:foregroundServiceType="dataSync" />

		<!-- Кнопки уведомлений видео-загрузок; intent-filter не нужен —
		     PendingIntent указывает компонент явно. -->
		<receiver
			android:name="my.noveldokusha.features.reader.video.VideoDownloadNotificationReceiver"
			android:exported="false" />
	</application>
</manifest>
